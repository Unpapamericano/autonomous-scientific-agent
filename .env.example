# Hugging Face API Token (for model downloads)
HF_TOKEN=hf_your_token_here

# Database
POSTGRES_PASSWORD=changeme
DATABASE_URL=postgresql://agent:changeme@postgres:5432/scientific_agent

# Muse Glimmer Configuration
MUSE_BACKEND=huggingface
MUSE_MODEL_ID=meta-models/Muse-Glimmer-30B
MUSE_QUANTIZATION=4-bit
MUSE_MAX_TOKENS=2048
MUSE_TEMPERATURE=1.0
MUSE_DEVICE=auto

# Ollama alternative (preferred local-efficient default)
OLLAMA_HOST=http://127.0.0.1:11434
MUSE_BACKEND=ollama
MUSE_MODEL_ID=qwen3:8b

# API
API_HOST=0.0.0.0
API_PORT=8000
API_LOG_LEVEL=info

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# Research APIs
PUBMED_API_KEY=
ARXIV_API_KEY=
OPENALEX_API_KEY=

# Security
ALLOW_SANDBOX_CODE_EXECUTION=false
SANDBOX_TIMEOUT_SECONDS=30
SANDBOX_MAX_MEMORY_MB=512

# Evaluation
ENABLE_EVALUATION_ENDPOINTS=false
