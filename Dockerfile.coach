FROM python:3.11-slim

WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1

COPY pyproject.toml README.md ./
RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir fastapi "uvicorn[standard]" python-multipart PyJWT pydantic
COPY src/ src/
RUN useradd --create-home --uid 1000 coach \
    && mkdir -p /app/data \
    && chown -R coach:coach /app
USER coach

EXPOSE 8000
CMD ["uvicorn", "src.trombone_coach.api:app", "--host", "0.0.0.0", "--port", "8000"]
